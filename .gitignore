# --- Entorno de Python ---
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# --- Datos generados al usar la app ---
data/*
logs/
recordings/
*.sqlite3
*.db
# Excepción: historial de vehículos contados (30 ago – 28 sep 2026) como datos de ejemplo
!data/traffic_history.sqlite3
*.log
*.mp4
*.avi
!web/img/*.mp4
*.tmp
*.bak

# --- Modelos de IA (se descargan con packaging/prepare_models.py) ---
models/
*.pt
*.onnx
*_openvino_model/

# --- Archivos generados al crear el .exe ---
build/
dist/
*.exe

# --- Configuración local y secretos ---
.env
.env.*

# --- Archivos del sistema y del editor ---
.vscode/
.idea/
.claude/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# --- Ejecutable: los archivos para crear el .exe no se suben ---
build.bat
*.spec
packaging/
